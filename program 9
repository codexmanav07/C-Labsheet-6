#include <iostream>
using namespace std;

int main() {
    int a[2][2] = {{8, 7}, {6, 5}};
    int b[2][2] = {{1, 2}, {3, 4}};

    cout << "Difference of matrices:\n";
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++)
            cout << a[i][j] - b[i][j] << " ";
        cout << endl;
    }
    return 0;
}

Output:
Difference of matrices:
7 5
3 1