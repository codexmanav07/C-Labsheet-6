#include <iostream>
using namespace std;

int main() {
    int a[] = {10, 20, 30, 40, 50};
    int key = 20, l = 0, r = 4, m;

    while (l <= r) {
        m = (l + r) / 2;
        if (a[m] == key) {
            cout << "Element found";
            return 0;
        }
        if (a[m] < key) l = m + 1;
        else r = m - 1;
    }

    cout << "Element not found";
    return 0;
}

Output:
Element found
