#include <iostream>
using namespace std;

int main() {
    int a[] = {10, 20, 30, 40, 50};
    int l = 0, r = 4, m;

    while (l < r) {
        m = (l + r + 1) / 2;
        if (a[m] > a[m - 1])
            l = m;
        else
            r = m - 1;
    }

    cout << "Largest element = " << a[l];
    return 0;
}

Output:
Largest element = 50