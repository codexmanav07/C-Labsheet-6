#include <iostream>
using namespace std;

int main() {
    int a[] = {10, 20, 30, 40, 50};
    int key = 40, pos = -1;

    for (int i = 0; i < 5; i++)
        if (a[i] == key) {
            pos = i;
            break;
        }

    if (pos != -1)
        cout << "Found at position " << pos + 1;
    else
        cout << "Not found";

    return 0;
}

