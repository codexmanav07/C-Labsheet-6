#include <iostream>
using namespace std;

int main() {
    int arr[5];

    cout << "Enter 5 elements: ";
    for (int i = 0; i < 5; i++)
        cin >> arr[i];

    int maximum = arr[0], minimum = arr[0];

    for (int i = 1; i < 5; i++) {
        if (arr[i] > maximum) maximum = arr[i];
        if (arr[i] < minimum) minimum = arr[i];
    }

    cout << "Maximum = " << maximum << endl;
    cout << "Minimum = " << minimum;
    return 0;
}

Output:
Enter 5 elements: 12 5 28 3 17
Maximum = 28
Minimum = 3