#include <iostream>
#include <string>
using namespace std;

int main() {
    string names[4] = {"Rahul", "Amit", "Priya", "Neha"};

    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3 - i; j++)
            if (names[j] > names[j + 1]) {
                string t = names[j];
                names[j] = names[j + 1];
                names[j + 1] = t;
            }

    for (int i = 0; i < 4; i++)
        cout << names[i] << endl;
    return 0;
}

Output:
Amit
Neha
Priya
Rahul