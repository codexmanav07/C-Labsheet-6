#include <iostream>
using namespace std;

int main() {
    int a[5] = {5, 2, 4, 1, 3};

    for (int i = 0; i < 4; i++)
        for (int j = 0; j < 4 - i; j++)
            if (a[j] > a[j + 1]) {
                int t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
            }

    for (int i = 0; i < 5; i++)
        cout << a[i] << " ";
    return 0;
}

Output:
1 2 3 4 5