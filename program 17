#include <iostream>
using namespace std;

int main() {
    int a[] = {11, 22, 33, 44, 55};
    int key = 33, found = 0;

    for (int i = 0; i < 5; i++)
        if (a[i] == key)
            found = 1;

    if (found)
        cout << "Number is present";
    else
        cout << "Number is not present";

    return 0;
}

Output:
Number is present