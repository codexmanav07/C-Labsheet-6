#include <iostream>
using namespace std;

int main() {
    int a[2][2];

    cout << "Enter 4 elements: ";
    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            cin >> a[i][j];

    cout << "Matrix:\n";
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++)
            cout << a[i][j] << " ";
        cout << endl;
    }

    return 0;
}

Output:
Enter 4 elements: 1 2 3 4
Matrix:
1 2
3 4
